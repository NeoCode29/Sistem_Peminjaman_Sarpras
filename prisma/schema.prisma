// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PEMINJAM
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          UserRole        @default(PEMINJAM)
  mahasiswa     Mahasiswa?
  pegawai       Pegawai?

  position      String?
  gender        String?
  number_phone  String?

  // Relations
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Mahasiswa {
  id String @id @default(cuid())
  userId String @unique
  nim String?
  jurusan String?
  prodi String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pegawai {
  id String @id @default(cuid())
  userId String @unique
  nik String?
  unit_pegawai String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model KategoriSarana {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sarana    Sarana[]
}

model Satuan {
  id        String   @id @default(cuid())
  nama      String   @unique
  singkatan String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sarana    Sarana[]
}

// Membuat model untuk tabel Sarana

model Sarana {
  id             String            @id @default(cuid())
  nama           String
  kategoriId       String
  satuanId         String
  jenis          JenisBarang       
  stok           Int               @default(0) 
  sisa           Int               @default(0)
  status         StatusSarpras      @default(TERSEDIA)
  satuanSatuan   Satuan            @relation(fields: [satuanId], references: [id])
  kategoriSarana KategoriSarana    @relation(fields: [kategoriId], references: [id])
  detailSarana   DetailSarana[]    // untuk barang BERNOMOR
  lokasi         String?
  image_url      String?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model DetailSarana {
  id          String              @id @default(cuid())
  saranaId    String
  nomer_seri  String?
  status      StatusSarpras    @default(TERSEDIA)
  lokasi      String?
  sarana      Sarana              @relation(fields: [saranaId], references: [id], onDelete: Cascade)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([saranaId])
}

enum StatusSarpras {
  DIPINJAM
  TERSEDIA
  HILANG
  RUSAK
}

enum JenisBarang {
  BERNOMOR      
  TIDAK_BERNOMOR
}

// Membuat model untuk tabel prasarana

model Prasarana {
  id String @id @default(cuid())
  nama String
  lokasi String?
  kapasitas Int?
  deskripsi String?
  status StatusSarpras @default(TERSEDIA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image_url ImagePrasarana[]
}


model ImagePrasarana {
  id String @id @default(cuid())
  prasaranaId String
  image_url String
  prasarana Prasarana @relation(fields: [prasaranaId], references: [id], onDelete: Cascade)
}
